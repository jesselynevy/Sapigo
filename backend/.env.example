# Database: set DATABASE_URL directly, or use the individual DB_* values below.
DATABASE_SOURCE=local
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/sapigo

# Environment safety. The stub OTP provider is only permitted when this is development.
APP_ENV=development

# Alternative database settings when DATABASE_URL is not supplied.
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sapigo

# Twilio Verify WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Authentication
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=1440
AUTH_COOKIE_SECURE=true
AUTH_FRONTEND_ORIGIN=https://app.example.com
AUTH_OTP_PROVIDER=twilio

# Development-only OTP stub. Do not enable this provider outside local development.
# AUTH_OTP_PROVIDER=stub
# AUTH_STUB_WHATSAPP_NUMBER=+628123456789
# AUTH_STUB_OTP_CODE=123456
