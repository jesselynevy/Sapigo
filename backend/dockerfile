FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install uv

COPY pyproject.toml uv.lock README.md ./
ENV UV_HTTP_TIMEOUT=120
RUN uv sync --frozen

# Pull model weights from a public HF repo (no token needed)
RUN mkdir -p app/ai_service/inference/weights && \
    curl -L -f -o app/ai_service/inference/weights/embedding_net.pth \
    https://huggingface.co/SapiGo/Muzzle-Biometric-Embedding/resolve/main/embedding_net.pth

COPY . .

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]